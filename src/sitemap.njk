---
permalink: sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- set paths = ["/", "/about", "/soma-breath", "/healing", "/contact"] %}
{%- if classes.show_in_menu %}{% set paths = (paths.push("/classes"), paths) %}{% endif %}
{%- if corporate.show_in_menu %}{% set paths = (paths.push("/corporate"), paths) %}{% endif %}
{%- for path in paths %}
  <url><loc>{{ site.url }}{{ path }}</loc><lastmod>{{ page.date.toISOString().slice(0, 10) }}</lastmod></url>
{%- endfor %}
</urlset>
