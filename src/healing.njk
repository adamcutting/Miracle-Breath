---
layout: base.njk
permalink: healing.html
pageKey: healing
---
{%- from "icons.njk" import icon -%}
{%- set p = healing -%}
{%- set hero = p.hero %}{% set crumb = "Healing" %}
{% include "page-hero.njk" %}

    <!-- Intro -->
    <section class="section" aria-labelledby="intro-title">
      <div class="container">
        <div class="quote-feature reveal" style="max-width:64ch">
          <p class="eyebrow center">{{ p.intro.eyebrow | inline | safe }}</p>
          <p class="lead-intro">{{ p.intro.quote | inline | safe }}</p>
        </div>
      </div>
    </section>

    <!-- Three dimensions -->
    <section class="section services" aria-labelledby="dim-title">
      <div class="container">
        <div class="text-center center-block reveal">
          <p class="eyebrow center">{{ p.dimensions.eyebrow | inline | safe }}</p>
          <h2 class="section-title center-block" id="dim-title">{{ p.dimensions.title | heading | safe }}</h2>
          <p class="section-intro center-block">{{ p.dimensions.intro | inline | safe }}</p>
        </div>
        <div class="pillars">
          {%- for c in p.dimensions.cards %}
          <article class="pillar{% if c.colour == 'green' %} green{% endif %} reveal d{{ (loop.index0 % 4) + 1 }}">
            <div class="ring" aria-hidden="true">{{ icon(c.icon) }}</div>
            <h3>{{ c.title | heading | safe }}</h3>
            <p>{{ c.text | inline | safe }}</p>
          </article>
          {%- endfor %}
        </div>
      </div>
    </section>

    <!-- Nervous system split -->
    <section class="section" aria-labelledby="ns-title">
      <div class="container split">
        <div class="split__art reveal">
          {% photo p.nervous_system.image, p.nervous_system.image_alt, "split" %}
        </div>
        <div class="reveal d1">
          <p class="eyebrow">{{ p.nervous_system.eyebrow | inline | safe }}</p>
          <h2 class="section-title" id="ns-title">{{ p.nervous_system.title | heading | safe }}</h2>
          {{ p.nervous_system.body | md | safe }}
          <a class="btn btn--ghost" href="{{ p.nervous_system.button.link }}">{{ p.nervous_system.button.label | inline | safe }} <span class="arrow">→</span></a>
        </div>
      </div>
    </section>

    <!-- Who it helps -->
    <section class="section services" aria-labelledby="who-title">
      <div class="container">
        <div class="text-center center-block reveal">
          <p class="eyebrow center">{{ p.who.eyebrow | inline | safe }}</p>
          <h2 class="section-title center-block" id="who-title">{{ p.who.title | heading | safe }}</h2>
          <p class="section-intro center-block">{{ p.who.intro | inline | safe }}</p>
        </div>
        <div class="steps cols{% if p.who.cards.length == 5 %} steps--5{% endif %}">
          {%- for c in p.who.cards %}
          <article class="step reveal d{{ (loop.index0 % 4) + 1 }}">
            <h3>{{ c.title | heading | safe }}</h3>
            <p>{{ c.text | inline | safe }}</p>
          </article>
          {%- endfor %}
        </div>
      </div>
    </section>

    <!-- Notice -->
{%- set notice = p.notice %}
{% include "notice.njk" %}

    <!-- AMBIENT BAND -->
{%- set band = p.band %}
{% include "ambient.njk" %}

    <!-- CTA -->
{%- set cta = p.cta %}{% set ctaClass = " services" %}{% set ctaLabel = "Get started" %}
{% include "cta.njk" %}
