---
layout: base.njk
permalink: index.html
pageKey: home
---
{%- from "icons.njk" import icon -%}
{%- set p = home -%}
    <!-- ============ HERO ============ -->
    <section class="hero" aria-label="Welcome to Miracle Breath">
      <div class="seeds" aria-hidden="true"></div>
      <div class="container" style="position:relative;z-index:2;text-align:center">
        <div class="hero__breath">
          <div class="hero__emblem" aria-hidden="true">
            <picture>
              <source srcset="/assets/img/logo-full.webp" type="image/webp" />
              <img src="/assets/img/logo-full.png" width="489" height="393" alt="" fetchpriority="high" decoding="async" />
            </picture>
          </div>
          <p class="hero__wordmark">Miracle Breath</p>
        </div>
        <p class="eyebrow center">{{ p.hero.eyebrow | inline | safe }}</p>
        <h1>{{ p.hero.headline | heading | safe }}</h1>
        <p class="hero__lead center-block">{{ p.hero.intro | inline | safe }}</p>
        <div class="hero__actions" style="justify-content:center">
          <a class="btn btn--lg" href="{{ p.hero.primary.link }}">{{ p.hero.primary.label | inline | safe }} <span class="arrow">→</span></a>
          {%- if p.hero.secondary and p.hero.secondary.label %}
          <a class="btn btn--ghost btn--lg" href="{{ p.hero.secondary.link }}">{{ p.hero.secondary.label | inline | safe }}</a>
          {%- endif %}
        </div>
        <div class="hero__trustline">
          {%- for b in p.hero.badges %}
          <span>{{ icon(b.icon, "2") }}{{ b.text | inline | safe }}</span>
          {%- endfor %}
        </div>
      </div>
      <a class="scroll-hint" href="#welcome" aria-label="Scroll down">
        <span class="mouse"></span>
        Scroll
      </a>
    </section>

    <!-- ============ WELCOME ============ -->
    <section class="section" id="welcome" aria-labelledby="welcome-title">
      <div class="container split">
        <div class="split__art reveal">
          {% photo p.welcome.image, p.welcome.image_alt, "split" %}
        </div>
        <div class="reveal d1">
          <p class="eyebrow">{{ p.welcome.eyebrow | inline | safe }}</p>
          <h2 class="section-title" id="welcome-title">{{ p.welcome.title | heading | safe }}</h2>
          {{ p.welcome.body | md | safe }}
          <a class="btn btn--ghost" href="{{ p.welcome.button.link }}">{{ p.welcome.button.label | inline | safe }} <span class="arrow">→</span></a>
        </div>
      </div>
    </section>

    <!-- ============ BENEFITS ============ -->
    <section class="section services" aria-labelledby="benefits-title">
      <div class="container">
        <div class="text-center center-block reveal">
          <p class="eyebrow center">{{ p.benefits.eyebrow | inline | safe }}</p>
          <h2 class="section-title center-block" id="benefits-title">{{ p.benefits.title | heading | safe }}</h2>
          <p class="section-intro center-block">{{ p.benefits.intro | inline | safe }}</p>
        </div>
        <div class="pillars">
          {%- for c in p.benefits.cards %}
          <article class="pillar{% if c.colour == 'green' %} green{% endif %} reveal d{{ (loop.index0 % 4) + 1 }}">
            <div class="ring" aria-hidden="true">{{ icon(c.icon) }}</div>
            <h3>{{ c.title | heading | safe }}</h3>
            <p>{{ c.text | inline | safe }}</p>
          </article>
          {%- endfor %}
        </div>
      </div>
    </section>

    <!-- ============ SPEAKS TO YOU ============ -->
    <section class="section highlight-band" aria-labelledby="you-title">
      <div class="container split">
        <div class="reveal">
          <p class="eyebrow">{{ p.for_you.eyebrow | inline | safe }}</p>
          <h2 class="section-title" id="you-title">{{ p.for_you.title | heading | safe }}</h2>
          {{ p.for_you.body | md | safe }}
          <a class="btn btn--ghost" href="{{ p.for_you.button.link }}">{{ p.for_you.button.label | inline | safe }} <span class="arrow">→</span></a>
        </div>
        <div class="split__art reveal d1">
          {% photo p.for_you.image, p.for_you.image_alt, "split" %}
        </div>
      </div>
    </section>

    <!-- ============ MEET SAMANTHA (teaser) — photo + badge come from the About page ============ -->
    <section class="section" aria-labelledby="samantha-title">
      <div class="container split reverse">
        <div class="portrait-card reveal" role="img" aria-label="{{ about.portrait.image_alt }}">
          {% photo about.portrait.image, "", "portrait", { class: "photo" } %}
          <div class="about__badge"><strong>{{ about.portrait.name | inline | safe }}</strong><span>{{ about.portrait.role | inline | safe }}</span></div>
        </div>
        <div class="reveal d1">
          <p class="eyebrow">{{ p.samantha.eyebrow | inline | safe }}</p>
          <h2 class="section-title" id="samantha-title">{{ p.samantha.title | heading | safe }}</h2>
          {{ p.samantha.body | md | safe }}
          <a class="btn btn--ghost" href="{{ p.samantha.button.link }}">{{ p.samantha.button.label | inline | safe }} <span class="arrow">→</span></a>
        </div>
      </div>
    </section>

    <!-- ============ SOMA + HEALING teasers ============ -->
    <section class="section services" aria-label="Explore further">
      <div class="container">
        <div class="features-grid" style="margin-top:0">
          {%- for c in p.explore.cards %}
          <article class="feature-card reveal d{{ (loop.index0 % 4) + 1 }}">
            <div class="icon" aria-hidden="true">{{ icon(c.icon) }}</div>
            <h3>{{ c.title | heading | safe }}</h3>
            <p>{{ c.text | inline | safe }}</p>
            <p style="margin-top:1rem"><a class="cert-link" href="{{ c.link }}" style="color:var(--sage-700);font-weight:700;border-bottom:1.5px solid var(--gold-400)">{{ c.link_label | inline | safe }}</a></p>
          </article>
          {%- endfor %}
        </div>
      </div>
    </section>

    <!-- ============ CTA ============ -->
{%- set cta = p.cta %}{% set ctaClass = "" %}
{% include "cta.njk" %}
